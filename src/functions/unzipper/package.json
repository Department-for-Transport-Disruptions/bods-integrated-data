    "dependencies": {
        "@bods-integrated-data/shared": "workspace:^",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.162",
        "@types/node": "^24.13.2"
    }
}
